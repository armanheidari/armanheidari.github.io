---
// src/components/Header.astro
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "../data/profile";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "";
const isBlog = currentPath.startsWith("/blog");
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full backdrop-blur-md bg-stone-50/80 dark:bg-[#0c0e14]/80 border-b border-stone-200/60 dark:border-zinc-800/60 transition-colors duration-200"
>
  <div
    class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
  >
    <!-- Brand / Monogram: Dynamically revealed on scroll on home page -->
    <a
      id="header-brand"
      href="/"
      class:list={[
        "group flex items-center gap-2.5 text-zinc-900 dark:text-zinc-100 hover:opacity-90 transition-all duration-300 ease-out",
        isHome
          ? "opacity-0 -translate-y-2 pointer-events-none"
          : "opacity-100 translate-y-0 pointer-events-auto",
      ]}
      aria-label="Home"
    >
      <div
        class="relative w-8 h-8 rounded-lg overflow-hidden border border-zinc-200/80 dark:border-zinc-700/80 shadow-xs shrink-0 group-hover:scale-105 transition-transform"
      >
        <img
          src={profile.avatarUrl}
          alt={profile.name}
          width="32"
          height="32"
          class="w-full h-full object-cover"
        />
        <span
          class="absolute -bottom-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-500 border-2 border-white dark:border-[#0c0e14]"
        ></span>
      </div>
      <div class="flex flex-col">
        <span
          class="font-bold text-sm tracking-tight leading-tight text-zinc-900 dark:text-zinc-100"
        >
          {profile.name}
        </span>
        <span
          class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 leading-tight"
        >
          {profile.affiliation}
        </span>
      </div>
    </a>

    <!-- Navigation Links & Actions -->
    <div class="flex items-center gap-1.5 sm:gap-3">
      <nav class="flex items-center gap-1 text-sm font-medium">
        <a
          href="/"
          class:list={[
            "px-2.5 py-1.5 rounded-md transition-colors",
            isHome
              ? "text-zinc-900 dark:text-white bg-zinc-200/60 dark:bg-zinc-800/70"
              : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/40",
          ]}
        >
          Hub
        </a>
        <a
          href="/blog"
          class:list={[
            "px-2.5 py-1.5 rounded-md transition-colors",
            isBlog
              ? "text-zinc-900 dark:text-white bg-zinc-200/60 dark:bg-zinc-800/70"
              : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800/40",
          ]}
        >
          Blog
        </a>
      </nav>

      <div class="h-4 w-px bg-zinc-300 dark:bg-zinc-800 mx-1"></div>

      <!-- Theme Switcher -->
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  function setupHeaderScroll() {
    const brand = document.getElementById("header-brand");
    const heroTrigger = document.getElementById("hero-name-trigger");

    if (!brand) return;

    if (!heroTrigger) {
      brand.classList.remove("opacity-0", "-translate-y-2", "pointer-events-none");
      brand.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Hero name is in viewport: hide header brand
            brand.classList.add("opacity-0", "-translate-y-2", "pointer-events-none");
            brand.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
          } else {
            // Hero name has scrolled out of viewport: show header brand
            brand.classList.remove("opacity-0", "-translate-y-2", "pointer-events-none");
            brand.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
          }
        });
      },
      {
        root: null,
        threshold: 0,
        rootMargin: "-64px 0px 0px 0px"
      }
    );

    observer.observe(heroTrigger);
  }

  setupHeaderScroll();
  document.addEventListener("astro:after-swap", setupHeaderScroll);
</script>
