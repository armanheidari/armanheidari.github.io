---
// src/components/hub/SkillsPanel.astro
import { skillCategories } from "../../data/skills";
---

<div class="space-y-6">
  <!-- Section Title & Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-2">
    <div>
      <h2
        class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight"
      >
        07 - Skills
      </h2>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
        Machine Learning, Agentic AI, Core Languages, Scientific Computing, Front-End Engineering, and Developer Tools.
      </p>
    </div>
    <span
      class="text-xs font-mono px-2.5 py-1 rounded-full bg-violet-50 dark:bg-violet-950/50 text-violet-700 dark:text-violet-300 border border-violet-200/60 dark:border-violet-800/60 font-medium"
    >
      {skillCategories.length} Categories
    </span>
  </div>

  <!-- Skills Grid: Clean, Decluttered, Clickable Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
    {
      skillCategories.map((category) => (
        <article
          id={`card-${category.slug}`}
          class="group relative p-5 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-violet-500/50 dark:hover:border-violet-500/40 hover:shadow-md transition-all duration-150 cursor-pointer scroll-mt-24 flex flex-col justify-between"
        >
          <!-- Stretched link for full card clickability -->
          <a
            href={`/skills/${category.slug}`}
            class="absolute inset-0 z-0 rounded-2xl"
            aria-hidden="true"
            tabindex="-1"
          />

          <div class="space-y-3 pointer-events-none">
            <!-- Icon & Arrow header -->
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-violet-50 dark:bg-violet-950/60 border border-violet-200/60 dark:border-violet-800/60 flex items-center justify-center text-violet-600 dark:text-violet-400 transition-colors group-hover:bg-violet-100 dark:group-hover:bg-violet-900/50">
                {category.icon === 'brain' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04z" />
                    <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04z" />
                  </svg>
                )}
                {category.icon === 'bot' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="12" x="3" y="6" rx="2" />
                    <path d="M9 10h.01" /><path d="M15 10h.01" />
                    <path d="M12 2v4" /><path d="M10 14a2 2 0 0 0 4 0" />
                  </svg>
                )}
                {category.icon === 'code' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {category.icon === 'chart' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <path d="m19 9-5 5-4-4-3 3" />
                  </svg>
                )}
                {category.icon === 'layout' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M3 9h18" /><path d="M9 21V9" />
                  </svg>
                )}
                {category.icon === 'terminal' && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="4 17 10 11 4 5" />
                    <line x1="12" x2="20" y1="19" y2="19" />
                  </svg>
                )}
              </div>

              <div class="w-7 h-7 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 group-hover:bg-violet-50 dark:group-hover:bg-violet-950/40 group-hover:border-violet-200 dark:group-hover:border-violet-800 flex items-center justify-center transition-colors">
                <svg
                  class="w-3.5 h-3.5 text-zinc-400 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
            </div>

            <!-- Title & Simple Explanation -->
            <div class="space-y-1.5">
              <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors">
                {category.title}
              </h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {category.description}
              </p>
            </div>
          </div>

          <!-- Bottom micro-indicator -->
          <div class="pt-4 mt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-between pointer-events-none text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
            <span>{category.skills.length} Core Tools</span>
            <span class="group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors">
              Explore Stack →
            </span>
          </div>
        </article>
      ))
    }
  </div>
</div>
