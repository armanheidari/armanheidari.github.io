---
// src/components/hub/EducationPanel.astro
import { educationList, awardsList } from '../../data/education';

const subtabs = [
  { id: 'degrees', label: 'Academic Degrees', shortLabel: 'Degrees', count: educationList.length },
  { id: 'awards', label: 'Honors & Awards', shortLabel: 'Honors', count: awardsList.length }
];
---

<div class="space-y-6">
  <!-- Section Title & Header -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-2">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
        02 - Education & Academic Honors
      </h2>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
        Formal academic training in Computer Engineering & Artificial Intelligence, and nationwide honors.
      </p>
    </div>
    <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60 font-medium">
      {educationList.length} Degrees • {awardsList.length} Awards
    </span>
  </div>

  <!-- Interactive Subtabs Ribbon -->
  <div class="flex items-center gap-1.5 p-1 rounded-2xl bg-zinc-100/90 dark:bg-zinc-900/90 border border-zinc-200/70 dark:border-zinc-800/70 overflow-x-auto scrollbar-none">
    {subtabs.map((tab, idx) => (
      <button
        type="button"
        data-education-subtab={tab.id}
        class:list={[
          "education-subtab-btn flex-1 min-w-[120px] sm:min-w-0 inline-flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold transition-all duration-150 cursor-pointer select-none",
          idx === 0
            ? "active bg-white dark:bg-[#12151e] text-zinc-900 dark:text-white shadow-xs border border-zinc-200/60 dark:border-zinc-700/60"
            : "text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 hover:bg-white/40 dark:hover:bg-zinc-800/40"
        ]}
      >
        <span class="hidden sm:inline">{tab.label}</span>
        <span class="sm:hidden">{tab.shortLabel}</span>
        <span class="text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-zinc-200/70 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
          {tab.count}
        </span>
      </button>
    ))}
  </div>

  <!-- Subtab 1: Academic Degrees (Clickable Cards) -->
  <div id="education-subpanel-degrees" class="education-subpanel space-y-3">
    <div class="grid grid-cols-1 gap-3.5">
      {educationList.map((edu) => (
        <article
          id={`card-${edu.slug}`}
          class="group relative p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs hover:border-indigo-500/50 dark:hover:border-indigo-500/40 hover:shadow-md transition-all duration-150 cursor-pointer scroll-mt-24"
        >
          <!-- Stretched link for full card clickability -->
          <a href={`/education/${edu.slug}`} class="absolute inset-0 z-0 rounded-2xl" aria-hidden="true" tabindex="-1"></a>

          <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-5 pointer-events-none">
            <!-- Left: Logo + Info -->
            <div class="flex items-start gap-4 min-w-0 flex-1">
              <!-- Institution Logo -->
              {edu.logoUrl ? (
                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-white dark:bg-white border border-zinc-200/80 dark:border-zinc-700/80 flex items-center justify-center p-2 shrink-0 shadow-xs">
                  <img
                    src={edu.logoUrl}
                    alt={`${edu.institution} Logo`}
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class={`w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br ${edu.logoPlaceholder.bgGradient} border ${edu.logoPlaceholder.borderColor} flex flex-col items-center justify-center shrink-0 shadow-xs`}>
                  <span class={`text-xs sm:text-sm font-extrabold font-mono tracking-wider ${edu.logoPlaceholder.textColor}`}>
                    {edu.logoPlaceholder.shortName}
                  </span>
                  <span class="text-[8px] font-mono text-zinc-400 uppercase tracking-widest leading-none mt-0.5">
                    Logo
                  </span>
                </div>
              )}

              <!-- Degree, Dept, University -->
              <div class="space-y-1 min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href={`/education/${edu.slug}`}
                    class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors pointer-events-auto leading-snug"
                  >
                    {edu.degree} — {edu.field}
                  </a>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60">
                    {edu.badge}
                  </span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
                    {edu.status}
                  </span>
                </div>

                <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">
                  {edu.department} • <span class="text-zinc-700 dark:text-zinc-300 font-semibold">{edu.institution}</span>
                </p>

                <!-- GPA Showcase on Hub Card -->
                <div class="pt-2 flex flex-wrap items-center gap-2">
                  {edu.overallGpa4 && edu.generalCourses ? (
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-zinc-100/90 dark:bg-zinc-800/90 border border-zinc-200/60 dark:border-zinc-700/60 text-xs font-mono">
                      <span class="text-zinc-500 dark:text-zinc-400 font-medium">Overall GPA:</span>
                      <span class="font-bold text-zinc-900 dark:text-white">{edu.overallGpa4.toFixed(2)} / 4.00</span>
                      <span class="text-indigo-600 dark:text-indigo-400 font-semibold">({edu.overallGpa20?.toFixed(2)} / 20.00)</span>
                    </div>
                  ) : null}

                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-indigo-50/70 dark:bg-indigo-950/40 border border-indigo-200/60 dark:border-indigo-800/60 text-xs font-mono">
                    <span class="text-indigo-700 dark:text-indigo-300 font-medium">{edu.generalCourses ? "Major GPA:" : "GPA:"}</span>
                    <span class="font-bold text-indigo-950 dark:text-indigo-100">{edu.majorGpa4?.toFixed(2)} / 4.00</span>
                    <span class="text-indigo-600 dark:text-indigo-400 font-bold">({edu.majorGpa20?.toFixed(2)} / 20.00)</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right side: Start & End date + arrow -->
            <div class="flex items-center justify-between md:justify-end gap-3 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-zinc-100 dark:border-zinc-800/80">
              <span class="text-xs font-mono font-medium text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-1 rounded-lg border border-zinc-200/60 dark:border-zinc-700/60">
                {edu.startDate} – {edu.endDate}
              </span>

              <div class="w-8 h-8 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 group-hover:bg-indigo-50 dark:group-hover:bg-indigo-950/40 group-hover:border-indigo-200 dark:group-hover:border-indigo-800 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4 text-zinc-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Subtab 2: Honors & Awards -->
  <div id="education-subpanel-awards" class="education-subpanel hidden space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
      {awardsList.map((award) => (
        <article
          id={`card-${award.id}`}
          class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs flex flex-col justify-between space-y-3 scroll-mt-24"
        >
          <div class="space-y-2">
            <div class="flex items-start justify-between gap-2">
              <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200/60 dark:border-amber-800/60">
                {award.year}
              </span>
              {award.badge && (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60 font-semibold">
                  ✦ {award.badge}
                </span>
              )}
            </div>

            <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 leading-snug">
              {award.title}
            </h3>

            <p class="text-[11px] font-medium text-indigo-600 dark:text-indigo-400">
              {award.issuer}
            </p>

            <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed">
              {award.description}
            </p>
          </div>

          {award.highlight && (
            <div class="pt-2.5 border-t border-zinc-100 dark:border-zinc-800/80">
              <p class="text-[11px] text-zinc-500 dark:text-zinc-400 italic">
                "{award.highlight}"
              </p>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  function setupEducationSubtabs() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-education-subtab]');
    const panels = document.querySelectorAll<HTMLElement>('.education-subpanel');

    function switchSubtab(targetId: string) {
      if (!targetId) return;

      buttons.forEach((b) => {
        const isActive = b.getAttribute('data-education-subtab') === targetId;
        if (isActive) {
          b.classList.add('active', 'bg-white', 'dark:bg-[#12151e]', 'text-zinc-900', 'dark:text-white', 'shadow-xs', 'border', 'border-zinc-200/60', 'dark:border-zinc-700/60');
          b.classList.remove('text-zinc-500', 'dark:text-zinc-400');
        } else {
          b.classList.remove('active', 'bg-white', 'dark:bg-[#12151e]', 'text-zinc-900', 'dark:text-white', 'shadow-xs', 'border', 'border-zinc-200/60', 'dark:border-zinc-700/60');
          b.classList.add('text-zinc-500', 'dark:text-zinc-400');
        }
      });

      panels.forEach((panel) => {
        if (panel.id === `education-subpanel-${targetId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-education-subtab');
        if (targetId) switchSubtab(targetId);
      });
    });

    window.addEventListener('switch-education-subtab', (e: Event) => {
      const customEvent = e as CustomEvent<{ subtabId: string }>;
      if (customEvent.detail?.subtabId) {
        switchSubtab(customEvent.detail.subtabId);
      }
    });
  }

  setupEducationSubtabs();
  document.addEventListener('astro:after-swap', setupEducationSubtabs);
</script>
