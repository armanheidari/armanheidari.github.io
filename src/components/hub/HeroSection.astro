---
// src/components/hub/HeroSection.astro
import FormulaCanvas from "./FormulaCanvas.astro";
import { profile } from "../../data/profile";
---

<section
  class="relative w-full overflow-hidden min-h-[calc(100vh-4rem)] flex flex-col justify-between py-6 sm:py-10"
>
  <!-- Interactive Floating Formulas Canvas spanning the entire viewport hero -->
  <FormulaCanvas />

  <!-- Spacer to help vertical balance -->
  <div class="hidden sm:block h-2"></div>

  <!-- Foreground Content: Open, airy, and vertically centered -->
  <div
    class="relative z-10 w-full max-w-4xl mx-auto px-4 sm:px-6 my-auto flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-8 md:gap-12 pointer-events-auto"
  >
    <!-- Info Column -->
    <div class="flex-1 space-y-4 sm:space-y-5">
      <!-- Status Badge -->
      {
        profile.status.available && (
          <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-zinc-100/80 dark:bg-zinc-800/60 border border-zinc-200/70 dark:border-zinc-700/60 text-xs text-zinc-600 dark:text-zinc-300 select-none">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0" />
            <span class="font-medium tracking-tight">{profile.status.text}</span>
          </div>
        )
      }

      <!-- Name & Subtitle in Modern Typography with Observer Trigger -->
      <div class="space-y-1.5">
        <h1
          id="hero-name-trigger"
          class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white"
        >
          {profile.name}
          <span class="sr-only" lang="fa">{profile.persianName} - {profile.persianRole}</span>
        </h1>
        <p
          class="text-base sm:text-xl font-semibold text-blue-600 dark:text-blue-400"
        >
          {profile.role}
        </p>
        <p
          class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 font-mono"
        >
          {profile.subrole} • {profile.location}
        </p>
      </div>

      <!-- Research Statement Teaser -->
      <p
        class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-xl"
      >
        {profile.researchStatement}
      </p>

      <!-- Contact & Social Pills -->
      <div class="flex flex-wrap items-center gap-2.5 pt-2">
        {
          profile.socials.map((social) => (
            <a
              href={social.url}
              target={social.url.startsWith("mailto:") ? undefined : "_blank"}
              rel={
                social.url.startsWith("mailto:")
                  ? undefined
                  : "noopener noreferrer"
              }
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-medium bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/80 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-700/60 transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
              aria-label={social.label}
            >
              {social.name === "GitHub" && (
                <svg
                  class="w-3.5 h-3.5 fill-[#181717] dark:fill-white shrink-0"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  />
                </svg>
              )}
              {social.name === "LinkedIn" && (
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect width="24" height="24" rx="4" fill="#0A66C2" />
                  <path
                    d="M5.5 8.7h2.8v9.8H5.5V8.7zm1.4-4.7c.9 0 1.6.7 1.6 1.6s-.7 1.6-1.6 1.6-1.6-.7-1.6-1.6.7-1.6 1.6-1.6zm4.1 4.7h2.7v1.3h.1c.4-.7 1.3-1.5 2.8-1.5 3 0 3.6 2 3.6 4.5v5.5h-2.8v-4.9c0-1.2 0-2.7-1.7-2.7s-1.9 1.3-1.9 2.6v5h-2.8V8.7z"
                    fill="#fff"
                  />
                </svg>
              )}
              {social.name === "Google Scholar" && (
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M12 2.5L1 8.5L12 14.5L20.5 9.87V16.5H22V8.5L12 2.5Z"
                    fill="#4285F4"
                  />
                  <path
                    d="M5.5 12.38V16.5L12 20.5L18.5 16.5V12.38L12 16L5.5 12.38Z"
                    fill="#3367D6"
                  />
                </svg>
              )}
              {social.name === "ORCID" && (
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="12" fill="#A6CE39" />
                  <path
                    d="M8.1 17.5H6.7V7.5h1.4v10zm-.7-11.6c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9c0 .5-.4.9-.9.9zm2.8 11.6h3.6c2.7 0 4.3-1.8 4.3-5 0-3.1-1.6-5-4.3-5h-3.6v10zm1.4-8.7h2.1c1.7 0 2.9 1.1 2.9 3.7 0 2.5-1.1 3.7-2.9 3.7h-2.1V8.8z"
                    fill="#fff"
                  />
                </svg>
              )}
              {social.name === "Email" && (
                <svg
                  class="w-3.5 h-3.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <rect x="2" y="4" width="20" height="16" rx="3.5" fill="#EA4335" />
                  <path
                    d="M2.5 6.5L12 13L21.5 6.5"
                    stroke="#FFFFFF"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              <span>{social.name}</span>
            </a>
          ))
        }

        <!-- CV Button -->
        <a
          href={profile.cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-all hover:scale-[1.02] active:scale-[0.98] shadow-sm shadow-blue-500/20 cursor-pointer"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          <span>Curriculum Vitae</span>
        </a>
      </div>
    </div>

    <!-- Avatar Column -->
    <div class="relative shrink-0 self-center md:self-auto">
      <div
        class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-3xl overflow-hidden p-1.5 bg-gradient-to-br from-blue-500/20 via-indigo-500/10 to-teal-500/20 border border-zinc-200 dark:border-zinc-800 shadow-xl"
      >
        <img
          src={profile.avatarUrl}
          alt={profile.name}
          width="176"
          height="176"
          class="w-full h-full object-cover rounded-2xl"
          loading="eager"
        />
      </div>
      <div
        class="absolute -bottom-2 -right-2 px-3 py-0.5 rounded-full text-[10px] font-mono font-bold bg-zinc-950 text-white dark:bg-zinc-100 dark:text-zinc-950 shadow-sm border border-zinc-700/30"
      >
        AI / ML
      </div>
    </div>
  </div>

  <!-- Bottom: Scroll to explore indication -->
  <div
    class="relative z-10 pt-8 pb-2 flex flex-col items-center justify-center text-center pointer-events-auto w-full max-w-4xl mx-auto px-4 sm:px-6"
  >
    <button
      id="scroll-to-explore-btn"
      type="button"
      class="group inline-flex flex-col items-center gap-2 text-zinc-400 dark:text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer focus:outline-none"
      aria-label="Scroll to explore sections"
    >
      <span
        class="text-[11px] font-mono tracking-widest uppercase font-semibold"
      >
        Scroll to explore
      </span>
      <div
        class="w-8 h-8 rounded-full border border-zinc-300 dark:border-zinc-700 group-hover:border-blue-500 flex items-center justify-center transition-colors"
      >
        <svg
          class="w-4 h-4 animate-bounce text-zinc-500 dark:text-zinc-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14"></path>
          <path d="m19 12-7 7-7-7"></path>
        </svg>
      </div>
    </button>
  </div>
</section>

<script>
  function setupScrollToExplore() {
    const btn = document.getElementById("scroll-to-explore-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        const target = document.getElementById("sections-hub");
        if (target) {
          target.scrollIntoView({ behavior: "smooth" });
        }
      });
    }
  }

  setupScrollToExplore();
  document.addEventListener("astro:after-swap", setupScrollToExplore);
</script>
