---
// src/components/hub/FormulaCanvas.astro
---

<div
  id="formula-canvas-wrapper"
  class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none select-none z-0"
  aria-hidden="true"
>
  <canvas id="formula-canvas" class="w-full h-full block pointer-events-none select-none"></canvas>
</div>

<script is:inline>
(function() {
  const formulas = [
    "V^*(s) = max_a [R(s,a) + γ ∑ P(s'|s,a) V^*(s')]",
    "∇_θ J(θ) = E_π [∇_θ log π_θ(a|s) Q^π(s,a)]",
    "L_{CLIP}(θ) = E [min(r_t A_t, clip(r_t, 1±ε) A_t)]",
    "Attention(Q,K,V) = softmax(QK^T / √d_k)V",
    "δ_t = R_{t+1} + γ V(S_{t+1}) - V(S_t)",
    "L_{CE} = -∑ y_i log(ŷ_i)",
    "θ_{t+1} = θ_t - η ∇_θ L(θ)",
    "Q(s,a) ← Q(s,a) + α [r + γ max_{a'} Q(s',a') - Q(s,a)]",
    "p(θ|D) = p(D|θ) p(θ) / p(D)",
    "D_{KL}(π_{old} || π) ≤ δ",
    "A^{GAE} = ∑ (γλ)^l δ_{t+l}",
    "σ(z) = 1 / (1 + e^{-z})",
    "E_{τ~π} [∑ γ^t R(s_t, a_t)]",
    "argmax_a Q^*(s, a)",
  ];

  function parseFormula(raw) {
    const segments = [];
    let i = 0;
    let currentNormal = "";

    function flushNormal() {
      if (currentNormal) {
        segments.push({ text: currentNormal, type: "normal" });
        currentNormal = "";
      }
    }

    while (i < raw.length) {
      const char = raw[i];
      if (char === "^" || char === "_") {
        flushNormal();
        const type = char === "^" ? "sup" : "sub";
        i++;
        if (i < raw.length) {
          if (raw[i] === "{") {
            i++;
            let content = "";
            while (i < raw.length && raw[i] !== "}") {
              content += raw[i];
              i++;
            }
            if (i < raw.length && raw[i] === "}") {
              i++;
            }
            if (content) segments.push({ text: content, type: type });
          } else {
            segments.push({ text: raw[i], type: type });
            i++;
          }
        }
      } else {
        currentNormal += char;
        i++;
      }
    }
    flushNormal();
    return segments;
  }

  const parsedFormulas = formulas.map(parseFormula);

  function setupFormulaCanvas() {
    const wrapper = document.getElementById("formula-canvas-wrapper");
    const canvas = document.getElementById("formula-canvas");
    if (!wrapper || !canvas) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let fontSize = 13;
    let particles = [];
    let mouse = { x: -9999, y: -9999, active: false };
    let animId = 0;
    let isRunning = false;
    let lastTime = 0;
    let cachedRect = { left: 0, top: 0, width: 0, height: 0 };

    function updateRect() {
      if (!wrapper) return;
      const r = wrapper.getBoundingClientRect();
      cachedRect = {
        left: r.left + window.scrollX,
        top: r.top + window.scrollY,
        width: r.width,
        height: r.height,
      };
    }

    function measureAll(c, fs) {
      const normalFont = '600 ' + fs + 'px "JetBrains Mono", ui-monospace, monospace';
      const scriptFont = '600 ' + Math.max(8, Math.round(fs * 0.72)) + 'px "JetBrains Mono", ui-monospace, monospace';
      return parsedFormulas.map(function(segments) {
        let totalW = 0;
        const measuredSegs = segments.map(function(seg) {
          c.font = seg.type === 'normal' ? normalFont : scriptFont;
          const w = c.measureText(seg.text).width;
          totalW += w;
          return { text: seg.text, type: seg.type, width: w };
        });
        return {
          segments: measuredSegs,
          width: Math.ceil(totalW) + 4,
          height: Math.ceil(fs * 2.2),
        };
      });
    }

    let measuredFormulas = [];

    function resize() {
      if (!wrapper || !canvas || !ctx) return;
      const rect = wrapper.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return;

      const newDpr = Math.min(window.devicePixelRatio || 1, 2);
      const newWidth = Math.round(rect.width);
      const newHeight = Math.round(rect.height);
      const newFontSize = newWidth < 640 ? 11 : 13;

      if (
        newWidth === width &&
        newHeight === height &&
        newDpr === dpr &&
        newFontSize === fontSize &&
        particles.length > 0
      ) {
        updateRect();
        return;
      }

      width = newWidth;
      height = newHeight;
      dpr = newDpr;
      fontSize = newFontSize;

      canvas.width = Math.ceil(width * dpr);
      canvas.height = Math.ceil(height * dpr);
      ctx.scale(dpr, dpr);

      updateRect();
      measuredFormulas = measureAll(ctx, fontSize);

      if (particles.length === 0) {
        initParticles();
      } else {
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          const mf = measuredFormulas[p.formulaIndex];
          if (mf) {
            p.width = mf.width;
            p.height = mf.height;
          }
        }
      }
    }

    function initParticles() {
      particles = [];
      const count = width < 640 ? 9 : width < 1100 ? 15 : 22;

      for (let i = 0; i < count; i++) {
        const formulaIndex = i % formulas.length;
        const mf = measuredFormulas[formulaIndex];
        const pWidth = mf ? mf.width : 120;
        const pHeight = mf ? mf.height : 24;

        const x = Math.random() * Math.max(20, width - pWidth - 30) + 15;
        const y = Math.random() * Math.max(20, height - pHeight - 30) + pHeight + 10;
        const speed = 0.32 + Math.random() * 0.28;
        const angle = Math.random() * Math.PI * 2;

        particles.push({
          formulaIndex: formulaIndex,
          x: x,
          y: y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          baseOpacity: 0.12 + Math.random() * 0.05,
          currentOpacity: 0.12,
          width: pWidth,
          height: pHeight,
          isEnergized: false,
        });
      }
    }

    function handlePointerMove(e) {
      const rx = e.pageX - cachedRect.left;
      const ry = e.pageY - cachedRect.top;

      if (
        rx >= -40 &&
        rx <= cachedRect.width + 40 &&
        ry >= -40 &&
        ry <= cachedRect.height + 40
      ) {
        mouse.x = rx;
        mouse.y = ry;
        mouse.active = true;
      } else {
        mouse.active = false;
        mouse.x = -9999;
        mouse.y = -9999;
      }
    }

    function handlePointerLeave() {
      mouse.active = false;
      mouse.x = -9999;
      mouse.y = -9999;
    }

    window.addEventListener("pointermove", handlePointerMove, { passive: true });
    document.addEventListener("mouseleave", handlePointerLeave, { passive: true });
    window.addEventListener("scroll", updateRect, { passive: true });
    window.addEventListener("resize", updateRect, { passive: true });

    function handleVisibilityChange() {
      if (document.hidden) {
        isRunning = false;
        cancelAnimationFrame(animId);
        mouse.active = false;
        mouse.x = -9999;
        mouse.y = -9999;
      } else {
        updateRect();
        lastTime = performance.now();
        if (!isRunning) {
          isRunning = true;
          animId = requestAnimationFrame(render);
        }
      }
    }

    document.addEventListener("visibilitychange", handleVisibilityChange, { passive: true });
    window.addEventListener("blur", handlePointerLeave, { passive: true });

    const radius = 135;

    function render(time) {
      if (!ctx || !isRunning) return;
      if (!time) time = performance.now();

      if (!lastTime) lastTime = time;
      const elapsed = time - lastTime;
      lastTime = time;
      const dt = Math.min(Math.max(elapsed / 16.667, 0.4), 2.0);

      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains("dark");
      const baseColor = isDark ? "rgb(226, 232, 240)" : "rgb(30, 41, 59)";
      const highlightColor = isDark ? "rgb(59, 130, 246)" : "rgb(37, 99, 235)";

      const normalFont = '600 ' + fontSize + 'px "JetBrains Mono", ui-monospace, monospace';
      const scriptFont = '600 ' + Math.max(8, Math.round(fontSize * 0.72)) + 'px "JetBrains Mono", ui-monospace, monospace';
      const baselineOffset = Math.round(fontSize * 1.4);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const mf = measuredFormulas[p.formulaIndex];
        if (!mf) continue;

        const cx = p.x + p.width / 2;
        const cy = p.y - p.height / 2;

        if (mouse.active) {
          const dx = cx - mouse.x;
          const dy = cy - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < radius && dist > 1) {
            const force = (1 - dist / radius) * 3.6;
            const nx = dx / dist;
            const ny = dy / dist;

            p.vx += nx * force * dt;
            p.vy += ny * force * dt;

            p.x += nx * force * 0.85 * dt;
            p.y += ny * force * 0.85 * dt;

            p.currentOpacity = 0.55;
            p.isEnergized = true;
          } else {
            p.isEnergized = false;
          }
        } else {
          p.isEnergized = false;
        }

        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > 0.6) {
          p.vx *= 0.93;
          p.vy *= 0.93;
        } else if (speed < 0.2) {
          p.vx *= 1.05;
          p.vy *= 1.05;
        }

        if (!p.isEnergized) {
          p.currentOpacity += (p.baseOpacity - p.currentOpacity) * 0.08 * dt;
        }

        p.x += p.vx * dt;
        p.y += p.vy * dt;

        if (p.x < 10) {
          p.x = 10;
          p.vx = Math.abs(p.vx) * 0.85;
        } else if (p.x + p.width > width - 10) {
          p.x = width - p.width - 10;
          p.vx = -Math.abs(p.vx) * 0.85;
        }

        if (p.y - p.height < 10) {
          p.y = p.height + 10;
          p.vy = Math.abs(p.vy) * 0.85;
        } else if (p.y > height - 10) {
          p.y = height - 10;
          p.vy = -Math.abs(p.vy) * 0.85;
        }

        ctx.save();
        ctx.globalAlpha = p.currentOpacity;
        ctx.fillStyle = p.isEnergized ? highlightColor : baseColor;

        let curX = Math.round(p.x);
        const baseY = Math.round(p.y - p.height * 0.7) + baselineOffset;

        for (let s = 0; s < mf.segments.length; s++) {
          const seg = mf.segments[s];
          if (seg.type === "normal") {
            ctx.font = normalFont;
            ctx.fillText(seg.text, curX, baseY);
          } else if (seg.type === "sup") {
            ctx.font = scriptFont;
            ctx.fillText(seg.text, curX, baseY - fontSize * 0.4);
          } else if (seg.type === "sub") {
            ctx.font = scriptFont;
            ctx.fillText(seg.text, curX, baseY + fontSize * 0.22);
          }
          curX += seg.width;
        }
        ctx.restore();
      }

      animId = requestAnimationFrame(render);
    }

    const resizeObserver = new ResizeObserver(() => {
      resize();
    });
    resizeObserver.observe(wrapper);

    resize();
    isRunning = true;
    lastTime = performance.now();
    animId = requestAnimationFrame(render);
  }

  // Instant startup at 0ms (no Vite module fetch, no deferred wait)
  setupFormulaCanvas();
  document.addEventListener("astro:after-swap", setupFormulaCanvas);
})();
</script>
