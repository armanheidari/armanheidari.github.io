---
// src/pages/experience/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { workExperiences } from '../../data/experience';

export function getStaticPaths() {
  return workExperiences.map((exp, index) => {
    const prev = index > 0
      ? {
          label: "Previous Role",
          title: workExperiences[index - 1].role,
          href: `/experience/${workExperiences[index - 1].slug}`
        }
      : {
          label: "Previous Section",
          title: "04 - Research & Publications",
          href: `/#research`
        };

    const next = index < workExperiences.length - 1
      ? {
          label: "Next Role",
          title: workExperiences[index + 1].role,
          href: `/experience/${workExperiences[index + 1].slug}`
        }
      : {
          label: "Next Section",
          title: "06 - Selected Projects",
          href: `/#projects`
        };

    return {
      params: { slug: exp.slug },
      props: { experience: exp, prev, next },
    };
  });
}

const { experience, prev, next } = Astro.props;
---

<BaseLayout
  title={`${experience.role} at ${experience.company} | Arman Heidari`}
  description={experience.headline}
>
  <div class="space-y-10 sm:space-y-12">
    <!-- Breadcrumb & Back Navigation directly to the card on hub -->
    <div class="flex items-center justify-between">
      <a
        href={`/#card-${experience.slug}`}
        class="group inline-flex items-center gap-2 text-xs font-mono font-medium text-zinc-500 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors"
      >
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span>Back to Work Experience Hub</span>
      </a>

      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
        Work Experience / Case Study
      </span>
    </div>

    <!-- Header Hero Card -->
    <header class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-sm space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
            <span>Machine Learning Engineering</span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
            {experience.role}
          </h1>

          <p class="text-base sm:text-lg font-semibold text-blue-600 dark:text-blue-400">
            {experience.company} <span class="text-zinc-400 dark:text-zinc-500 font-normal">• {experience.location}</span>
          </p>
        </div>

        <div class="flex flex-col items-end gap-1.5 shrink-0">
          <span class="text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/90 px-3.5 py-1.5 rounded-xl border border-zinc-200/60 dark:border-zinc-700/60">
            {experience.period}
          </span>
          <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">
            Full-time Role
          </span>
        </div>
      </div>

      <!-- Executive Overview -->
      <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500">
          Executive Summary & Scope
        </h2>
        <p class="text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
          {experience.overview}
        </p>
      </div>

      <!-- Quick Tech Pills -->
      <div class="flex flex-wrap items-center gap-1.5 pt-2">
        {experience.skills.map((skill) => (
          <span class="text-[11px] font-mono px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50">
            {skill}
          </span>
        ))}
      </div>
    </header>

    <!-- Deep Dive into Major Systems Architected -->
    <div class="space-y-10 sm:space-y-12">
      <div class="flex items-center gap-3">
        <div class="w-2.5 h-6 rounded-full bg-blue-600"></div>
        <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white tracking-tight">
          Major Systems Architected & Implemented
        </h2>
      </div>

      {experience.projects.map((proj, idx) => (
        <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-sm space-y-6">
          <!-- System Header -->
          <div class="space-y-1.5 border-b border-zinc-100 dark:border-zinc-800/80 pb-4">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200">
                0{idx + 1}
              </span>
              <span class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
                Production System Architecture
              </span>
            </div>

            <h3 class="text-lg sm:text-2xl font-bold text-zinc-900 dark:text-white leading-snug">
              {proj.title}
            </h3>

            <p class="text-xs sm:text-sm text-blue-600 dark:text-blue-400 font-medium">
              {proj.subtitle}
            </p>
          </div>

          <!-- Structured Technical Breakdown Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs sm:text-sm">
            <!-- Context & Problem -->
            <div class="p-4 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200/60 dark:border-zinc-800/60 space-y-2">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                The Operational Problem
              </span>
              <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">
                {proj.context}
              </p>
            </div>

            <!-- Architecture & Ingestion -->
            <div class="p-4 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200/60 dark:border-zinc-800/60 space-y-2">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                Pipeline & Architecture
              </span>
              <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">
                {proj.architecture}
              </p>
            </div>

            <!-- ML Methodology -->
            <div class="p-4 rounded-2xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-zinc-200/60 dark:border-zinc-800/60 space-y-2">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
                Machine Learning Methodology
              </span>
              <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">
                {proj.methodology}
              </p>
            </div>

            <!-- Quantified Impact -->
            <div class="p-4 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/60 dark:border-emerald-900/40 space-y-2">
              <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">
                Operational Impact & Results
              </span>
              <p class="text-zinc-800 dark:text-zinc-200 leading-relaxed font-medium">
                {proj.impact}
              </p>
            </div>
          </div>

          <!-- Bullet Points from CV -->
          <div class="space-y-2 pt-2">
            <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500">
              Technical Highlights & Implementation Details
            </span>
            <ul class="space-y-2 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
              {proj.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-500 mt-1 text-xs">▸</span>
                  <span class="leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Project Specific Tech Stack -->
          <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center gap-1.5">
            <span class="text-[11px] font-mono text-zinc-400 mr-1 font-medium">Technologies:</span>
            {proj.techStack.map((tech) => (
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200/40 dark:border-zinc-700/40">
                {tech}
              </span>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Key Outcomes Summary Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-blue-500/5 via-indigo-500/5 to-transparent border border-blue-200/60 dark:border-blue-900/40 space-y-4">
      <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-white">
        Key Accomplishments & Outcomes
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {experience.keyOutcomes.map((outcome, idx) => (
          <div class="p-4 rounded-2xl bg-white/80 dark:bg-[#12151e]/80 border border-zinc-200/60 dark:border-zinc-800/60 space-y-2">
            <span class="font-mono text-xs font-bold text-blue-600 dark:text-blue-400">
              Outcome 0{idx + 1}
            </span>
            <p class="text-xs text-zinc-700 dark:text-zinc-300 leading-relaxed font-medium">
              {outcome}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom Navigation: Prev / Next Switcher Between Cards & Sections -->
    <div class="pt-8 border-t border-zinc-200/60 dark:border-zinc-800/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Previous Button -->
      <a
        href={prev.href}
        class="group flex flex-col p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 hover:border-blue-500/50 dark:hover:border-blue-500/40 hover:shadow-md transition-all text-left min-w-0 overflow-hidden"
      >
        <span class="text-[11px] font-mono font-semibold text-zinc-400 dark:text-zinc-500 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors flex items-center gap-1.5 shrink-0">
          <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span class="truncate">{prev.label}</span>
        </span>
        <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mt-1 line-clamp-2 leading-snug break-words">
          {prev.title}
        </span>
      </a>

      <!-- Next Button -->
      <a
        href={next.href}
        class="group flex flex-col p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 hover:border-blue-500/50 dark:hover:border-blue-500/40 hover:shadow-md transition-all text-right sm:items-end min-w-0 overflow-hidden"
      >
        <span class="text-[11px] font-mono font-semibold text-zinc-400 dark:text-zinc-500 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors flex items-center gap-1.5 justify-end shrink-0">
          <span class="truncate">{next.label}</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </span>
        <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mt-1 line-clamp-2 leading-snug break-words">
          {next.title}
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
