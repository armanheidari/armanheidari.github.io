---
// src/pages/education/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  educationList,
  sortCourses,
  computeWeightedGPA,
  type Course
} from '../../data/education';

export function getStaticPaths() {
  return educationList.map((edu, index) => {
    // If index === 0, previous is Section 01: About Me
    const prev = index > 0
      ? {
          label: "Previous Degree",
          title: educationList[index - 1].degree,
          href: `/education/${educationList[index - 1].slug}`
        }
      : {
          label: "Previous Section",
          title: "01 - About Me",
          href: `/#about`
        };

    // If index === last, next is Section 03: Teaching & Mentorship
    const next = index < educationList.length - 1
      ? {
          label: "Next Degree",
          title: educationList[index + 1].degree,
          href: `/education/${educationList[index + 1].slug}`
        }
      : {
          label: "Next Section",
          title: "03 - Teaching & Mentorship Hub",
          href: `/#teaching`
        };

    return {
      params: { slug: edu.slug },
      props: { edu, prev, next },
    };
  });
}

const { edu, prev, next } = Astro.props;

// Sort courses: highest score first, highest credits as tie-breaker
const sortedMajorCourses = sortCourses(edu.majorCourses);
const sortedGeneralCourses = edu.generalCourses ? sortCourses(edu.generalCourses) : [];

// Compute GPAs (using explicit overrides if available, otherwise computed)
const computedMajor = computeWeightedGPA(edu.majorCourses);
const majorGpa4 = edu.majorGpa4 ?? computedMajor.gpa4;
const majorGpa20 = edu.majorGpa20 ?? computedMajor.gpa20;

const allCourses = [...edu.majorCourses, ...(edu.generalCourses || [])];
const computedOverall = computeWeightedGPA(allCourses);
const overallGpa4 = edu.overallGpa4 ?? computedOverall.gpa4;
const overallGpa20 = edu.overallGpa20 ?? computedOverall.gpa20;

// Conversion function for display in row
function getScore4(score: number): string {
  if (score >= 17) return "4.00";
  if (score >= 14) return (3.0 + ((score - 14) / 3)).toFixed(2);
  return ((score / 20) * 4.0).toFixed(2);
}
---

<BaseLayout
  title={`${edu.degree} in ${edu.field} | ${edu.institution} | Arman Heidari`}
  description={edu.explanation}
>
  <div class="space-y-8 sm:space-y-10">
    <!-- Breadcrumb & Back Navigation directly to the card on hub -->
    <div class="flex items-center justify-between">
      <a
        href={`/#card-${edu.slug}`}
        class="group inline-flex items-center gap-2 text-xs font-mono font-medium text-zinc-500 hover:text-indigo-600 dark:text-zinc-400 dark:hover:text-indigo-400 transition-colors"
      >
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span>Back to Education & Honors Hub</span>
      </a>

      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
        Academic Curriculum & Transcripts
      </span>
    </div>

    <!-- Header Hero Card with Logo Placeholder & Degree Details -->
    <header class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-5">
        <div class="flex items-start gap-4">
          <!-- Real Logo Display / Monogram Fallback -->
          {edu.logoUrl ? (
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-white dark:bg-white border border-zinc-200/80 dark:border-zinc-700/80 flex items-center justify-center p-2.5 shrink-0 shadow-xs">
              <img
                src={edu.logoUrl}
                alt={`${edu.institution} Logo`}
                class="w-full h-full object-contain"
                loading="eager"
              />
            </div>
          ) : (
            <div class={`w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br ${edu.logoPlaceholder.bgGradient} border ${edu.logoPlaceholder.borderColor} flex flex-col items-center justify-center shrink-0 shadow-xs`}>
              <span class={`text-sm sm:text-base font-extrabold font-mono tracking-wider ${edu.logoPlaceholder.textColor}`}>
                {edu.logoPlaceholder.shortName}
              </span>
              <span class="text-[9px] font-mono text-zinc-400 uppercase tracking-widest mt-0.5">
                Logo
              </span>
            </div>
          )}

          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200/60 dark:border-indigo-800/60">
                {edu.badge}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
                {edu.status}
              </span>
            </div>

            <h1 class="text-xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
              {edu.degree} in {edu.field}
            </h1>

            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-medium">
              {edu.department} • <span class="text-zinc-900 dark:text-zinc-100 font-semibold">{edu.institution}</span>
            </p>
          </div>
        </div>

        <!-- Start & End Date Badge -->
        <div class="flex flex-col items-end gap-1.5 shrink-0">
          <span class="text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/90 px-3.5 py-1.5 rounded-xl border border-zinc-200/60 dark:border-zinc-700/60">
            {edu.startDate} – {edu.endDate}
          </span>
          <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
            {edu.location}
          </span>
        </div>
      </div>

      <!-- GPA Showcase Box (Rendered when GPAs exist; otherwise In-Progress status) -->
      {overallGpa4 !== undefined || (sortedMajorCourses.length > 0 && majorGpa4 !== undefined) ? (
        <div class="p-4 sm:p-5 rounded-2xl bg-zinc-50/80 dark:bg-zinc-900/40 border border-zinc-200/60 dark:border-zinc-800/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {edu.generalCourses && (
            <div class="space-y-1">
              <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400">
                Overall Cumulative GPA
              </span>
              <div class="flex items-baseline gap-2">
                <span class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-white font-mono">
                  {overallGpa4.toFixed(2)} <span class="text-xs text-zinc-400 font-normal">/ 4.00</span>
                </span>
                <span class="text-sm font-mono text-indigo-600 dark:text-indigo-400 font-bold">
                  ({overallGpa20.toFixed(2)} / 20.00)
                </span>
              </div>
            </div>
          )}

          <div class="space-y-1">
            <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400">
              {edu.generalCourses ? "Major-Specific GPA" : "Cumulative Master's GPA"}
            </span>
            <div class="flex items-baseline gap-2">
              <span class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-white font-mono">
                {majorGpa4.toFixed(2)} <span class="text-xs text-zinc-400 font-normal">/ 4.00</span>
              </span>
              <span class="text-sm font-mono text-indigo-600 dark:text-indigo-400 font-bold">
                ({majorGpa20.toFixed(2)} / 20.00)
              </span>
            </div>
          </div>
        </div>
      ) : (
        <div class="p-4 sm:p-5 rounded-2xl bg-blue-50/60 dark:bg-blue-950/30 border border-blue-200/60 dark:border-blue-900/40 flex items-center gap-3">
          <div class="w-2.5 h-2.5 rounded-full bg-blue-600 dark:bg-blue-400 shrink-0 animate-pulse"></div>
          <p class="text-xs sm:text-sm font-mono text-blue-900 dark:text-blue-200">
            Current Academic Standing: Graduate coursework active at Sharif University of Technology. Transcripts and GPAs will be updated upon completion of academic evaluations.
          </p>
        </div>
      )}

      <!-- Explanation of what I did -->
      <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 space-y-2">
        <h2 class="text-xs font-mono uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500">
          Academic Overview & Specialization
        </h2>
        <p class="text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
          {edu.explanation}
        </p>
      </div>
    </header>

    <!-- Table 1: Major-Specific Courses -->
    {sortedMajorCourses.length > 0 ? (
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 dark:border-zinc-800/80 pb-3">
          <div class="flex items-center gap-3">
            <div class="w-2.5 h-5 rounded-full bg-indigo-600"></div>
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white">
                Major-Specific Courses
              </h2>
              <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">
                Ranked by score (out of 20.0), with credits as tie-breaker
              </p>
            </div>
          </div>

          <div class="text-right">
            <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 px-2.5 py-1 rounded-lg border border-indigo-200/60 dark:border-indigo-800/60">
              Major GPA: {majorGpa4.toFixed(2)} / 4.00 ({majorGpa20.toFixed(2)} / 20.00)
            </span>
          </div>
        </div>

      <!-- Responsive Table Container -->
      <div class="overflow-x-auto rounded-2xl border border-zinc-200/60 dark:border-zinc-800/60">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-zinc-50 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 font-mono text-[11px] uppercase tracking-wider border-b border-zinc-200/60 dark:border-zinc-800/60">
            <tr>
              <th scope="col" class="py-3 px-3.5 text-center w-12">#</th>
              <th scope="col" class="py-3 px-4">Course Name</th>
              <th scope="col" class="py-3 px-3.5 text-center w-24">Credits</th>
              <th scope="col" class="py-3 px-4 text-center w-28">Score (/20)</th>
              <th scope="col" class="py-3 px-4 text-center w-28">Scale (/4.0)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200/50 dark:divide-zinc-800/50">
            {sortedMajorCourses.map((c, idx) => (
              <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-900/30 transition-colors">
                <td class="py-2.5 px-3.5 text-center font-mono text-zinc-400 dark:text-zinc-500 text-xs">
                  {idx + 1}
                </td>
                <td class="py-2.5 px-4 font-semibold text-zinc-900 dark:text-zinc-100">
                  {c.name}
                </td>
                <td class="py-2.5 px-3.5 text-center font-mono text-zinc-600 dark:text-zinc-300">
                  {c.credits}
                </td>
                <td class="py-2.5 px-4 text-center font-mono font-bold text-indigo-600 dark:text-indigo-400">
                  {c.score.toFixed(1)} <span class="text-zinc-400 font-normal text-xs">/ 20</span>
                </td>
                <td class="py-2.5 px-4 text-center font-mono text-zinc-700 dark:text-zinc-300">
                  {getScore4(c.score)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    ) : (
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-4">
        <div class="flex items-center gap-3 border-b border-zinc-100 dark:border-zinc-800/80 pb-3">
          <div class="w-2.5 h-5 rounded-full bg-blue-600"></div>
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white">
              Curriculum & Transcripts
            </h2>
            <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">
              M.Sc. Artificial Intelligence coursework
            </p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Graduate coursework is currently in progress at Sharif University of Technology. Individual course marks, credits, and cumulative GPA records will be published here upon completion of semester evaluations.
        </p>
      </section>
    )}

    <!-- Table 2: General & Foundational Courses (Only for B.Sc.) -->
    {sortedGeneralCourses.length > 0 && (
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 dark:border-zinc-800/80 pb-3">
          <div class="flex items-center gap-3">
            <div class="w-2.5 h-5 rounded-full bg-emerald-600"></div>
            <div>
              <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white">
                General & Foundational Courses
              </h2>
              <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">
                Mathematics, basic sciences, and general university requirements
              </p>
            </div>
          </div>
        </div>

        <!-- Responsive Table Container -->
        <div class="overflow-x-auto rounded-2xl border border-zinc-200/60 dark:border-zinc-800/60">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-zinc-50 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 font-mono text-[11px] uppercase tracking-wider border-b border-zinc-200/60 dark:border-zinc-800/60">
              <tr>
                <th scope="col" class="py-3 px-3.5 text-center w-12">#</th>
                <th scope="col" class="py-3 px-4">Course Name</th>
                <th scope="col" class="py-3 px-3.5 text-center w-24">Credits</th>
                <th scope="col" class="py-3 px-4 text-center w-28">Score (/20)</th>
                <th scope="col" class="py-3 px-4 text-center w-28">Scale (/4.0)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200/50 dark:divide-zinc-800/50">
              {sortedGeneralCourses.map((c, idx) => (
                <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-900/30 transition-colors">
                  <td class="py-2.5 px-3.5 text-center font-mono text-zinc-400 dark:text-zinc-500 text-xs">
                    {idx + 1}
                  </td>
                  <td class="py-2.5 px-4 font-semibold text-zinc-900 dark:text-zinc-100">
                    {c.name}
                  </td>
                  <td class="py-2.5 px-3.5 text-center font-mono text-zinc-600 dark:text-zinc-300">
                    {c.credits}
                  </td>
                  <td class="py-2.5 px-4 text-center font-mono font-bold text-emerald-600 dark:text-emerald-400">
                    {c.score.toFixed(1)} <span class="text-zinc-400 font-normal text-xs">/ 20</span>
                  </td>
                  <td class="py-2.5 px-4 text-center font-mono text-zinc-700 dark:text-zinc-300">
                    {getScore4(c.score)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Bottom Navigation: Prev / Next Switcher Between Cards & Sections -->
    <div class="pt-6 border-t border-zinc-200/60 dark:border-zinc-800/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Previous Button -->
      <a
        href={prev.href}
        class="group flex flex-col p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 hover:border-indigo-500/50 dark:hover:border-indigo-500/40 hover:shadow-md transition-all text-left min-w-0 overflow-hidden"
      >
        <span class="text-[11px] font-mono font-semibold text-zinc-400 dark:text-zinc-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors flex items-center gap-1.5 shrink-0">
          <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span class="truncate">{prev.label}</span>
        </span>
        <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mt-1 line-clamp-2 leading-snug break-words">
          {prev.title}
        </span>
      </a>

      <!-- Next Button -->
      <a
        href={next.href}
        class="group flex flex-col p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 hover:border-indigo-500/50 dark:hover:border-indigo-500/40 hover:shadow-md transition-all text-right sm:items-end min-w-0 overflow-hidden"
      >
        <span class="text-[11px] font-mono font-semibold text-zinc-400 dark:text-zinc-500 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors flex items-center gap-1.5 justify-end shrink-0">
          <span class="truncate">{next.label}</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </span>
        <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mt-1 line-clamp-2 leading-snug break-words">
          {next.title}
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
