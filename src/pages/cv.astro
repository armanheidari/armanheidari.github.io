---
// src/pages/cv.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const pageTitle = `Curriculum Vitae | Arman Heidari`;
const pageDesc = `Academic Curriculum Vitae of Arman Heidari, Master's student in Artificial Intelligence at Sharif University of Technology.`;
const pdfUrl = profile.pdfUrl || "/Arman_Heidari_Academic_CV.pdf";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="space-y-4 sm:space-y-6">
    <!-- Top Action Bar (Guaranteed Single Row on Both Mobile and Desktop) -->
    <div
      class="flex items-center justify-between gap-2.5 sm:gap-4 p-3 sm:p-5 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs"
    >
      <!-- Left: Back to Home Link -->
      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-xl text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/80 dark:hover:bg-zinc-700/80 text-zinc-700 dark:text-zinc-200 transition-colors cursor-pointer shrink-0"
        aria-label="Back to Portfolio Home"
      >
        <svg
          class="w-4 h-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span class="hidden sm:inline">Portfolio Home</span>
        <span class="inline sm:hidden">Home</span>
      </a>

      <!-- Middle: Title & Institution (Truncated cleanly if narrow screen) -->
      <div class="min-w-0 flex-1 px-1 sm:px-2">
        <h1
          class="text-xs sm:text-base font-bold text-zinc-900 dark:text-white leading-tight truncate"
        >
          Curriculum Vitae
        </h1>
        <p class="text-[10px] sm:text-xs text-zinc-500 dark:text-zinc-400 truncate">
          Arman Heidari &bull; Sharif University
        </p>
      </div>

      <!-- Right: Download Action -->
      <a
        href={pdfUrl}
        download="Arman_Heidari_Academic_CV.pdf"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-xs hover:shadow-md cursor-pointer shrink-0"
        aria-label="Download Curriculum Vitae PDF"
      >
        <svg
          class="w-3.5 h-3.5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download CV</span>
      </a>
    </div>

    <!-- 1. Mobile Document Experience (Shown on mobile screens < 768px where iframe PDFs fail) -->
    <div
      class="block md:hidden rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 p-5 sm:p-6 shadow-xs space-y-5"
    >
      <!-- Document Info Banner -->
      <div class="flex items-start gap-4">
        <div
          class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-900/60 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0"
        >
          <svg
            class="w-6 h-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <line x1="10" y1="9" x2="8" y2="9"></line>
          </svg>
        </div>
        <div class="space-y-1 min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span
              class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60"
            >
              Academic CV
            </span>
            <span class="text-[10px] font-mono text-zinc-400">PDF Document</span>
          </div>
          <h2 class="text-base font-bold text-zinc-900 dark:text-white leading-tight">
            Arman Heidari
          </h2>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            M.Sc. in Artificial Intelligence &bull; Sharif University of Technology
          </p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-2.5 pt-1">
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold text-xs sm:text-sm shadow-md shadow-blue-500/20 transition-all active:scale-[0.98] cursor-pointer"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Open Full CV in Mobile Viewer</span>
        </a>

        <a
          href={pdfUrl}
          download="Arman_Heidari_Academic_CV.pdf"
          class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 font-semibold text-xs border border-zinc-200/80 dark:border-zinc-700 transition-all active:scale-[0.98] cursor-pointer"
        >
          <svg
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Direct PDF Download</span>
        </a>
      </div>

      <!-- Quick Document Sections Highlights -->
      <div class="pt-3 border-t border-zinc-100 dark:border-zinc-800 space-y-3">
        <h3
          class="text-[11px] font-mono uppercase font-semibold text-zinc-400 dark:text-zinc-500 tracking-wider"
        >
          Document Highlights
        </h3>
        <div class="grid grid-cols-1 gap-2 text-xs">
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 space-y-0.5">
            <span class="font-bold text-zinc-900 dark:text-zinc-100">Education</span>
            <p class="text-zinc-600 dark:text-zinc-400 text-[11px]">
              M.Sc. in AI @ Sharif &bull; B.Sc. in Computer Eng @ ATU (GPA: 18.96 / 4.0)
            </p>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 space-y-0.5">
            <span class="font-bold text-zinc-900 dark:text-zinc-100">Research Focus</span>
            <p class="text-zinc-600 dark:text-zinc-400 text-[11px]">
              Multi-Agent RL, Safe RL, LLMs & Foundation Models
            </p>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 space-y-0.5">
            <span class="font-bold text-zinc-900 dark:text-zinc-100">Selected Publication</span>
            <p class="text-zinc-600 dark:text-zinc-400 text-[11px]">
              ISLE: In-Context Synthetic Data Generation (NeurIPS 2024 Workshop)
            </p>
          </div>
          <div class="p-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-800/60 space-y-0.5">
            <span class="font-bold text-zinc-900 dark:text-zinc-100">Honors & Awards</span>
            <p class="text-zinc-600 dark:text-zinc-400 text-[11px]">
              Ranked 1st in CE (Top 1%), Sharif AI Fellowship
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Desktop Embedded PDF Viewer (Rendered on tablet and laptop screens >= 768px) -->
    <div
      class="hidden md:block w-full rounded-2xl overflow-hidden bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-sm min-h-[78vh]"
    >
      <iframe
        src={`${pdfUrl}#toolbar=1&navpanes=0`}
        class="w-full h-[84vh] border-0"
        title="Arman Heidari Academic CV"
      >
        <p class="p-6 text-center text-sm text-zinc-600 dark:text-zinc-400">
          Your browser does not support inline PDF viewing.
          <a
            href={pdfUrl}
            download
            class="text-blue-600 underline font-semibold ml-1"
          >
            Download the CV directly here.
          </a>
        </p>
      </iframe>
    </div>
  </div>
</BaseLayout>
