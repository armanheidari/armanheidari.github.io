---
// src/pages/cv.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const pageTitle = `Curriculum Vitae | Arman Heidari`;
const pageDesc = `Academic and Professional Curriculum Vitae of Arman Heidari.`;
const pdfUrl = profile.pdfUrl || "/Arman_Heidari_Academic_CV.pdf";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="space-y-4 sm:space-y-6">
    <!-- Top Action Bar (Clean, Minimal, Zero Repetition) -->
    <div
      class="flex items-center justify-between gap-3 p-3 sm:p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs"
    >
      <!-- Left: Back to Home Link -->
      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800/80 dark:hover:bg-zinc-700/80 text-zinc-700 dark:text-zinc-200 transition-colors cursor-pointer shrink-0"
        aria-label="Back to Portfolio Home"
      >
        <svg
          class="w-4 h-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span class="hidden sm:inline">Portfolio Home</span>
        <span class="inline sm:hidden">Home</span>
      </a>

      <!-- Title (Single, clean heading) -->
      <div class="min-w-0 flex-1 text-right sm:text-left sm:pl-3">
        <h1
          class="text-sm sm:text-base font-bold text-zinc-900 dark:text-white leading-tight truncate"
        >
          Curriculum Vitae
        </h1>
      </div>
    </div>

    <!-- CV Cards Section: Academic CV & Future Work CV -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- 1. Academic CV (Active) -->
      <div
        class="relative p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#12151e] border-2 border-blue-500/30 dark:border-blue-500/30 shadow-xs flex flex-col justify-between space-y-4"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-semibold bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-blue-400"
              ></span>
              Academic
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500"
              >PDF &bull; 2026</span
            >
          </div>

          <div class="space-y-1">
            <h2
              class="text-base sm:text-lg font-bold text-zinc-900 dark:text-white"
            >
              Academic CV
            </h2>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Comprehensive record of research, graduate coursework,
              publications, academic honors, and teaching experience.
            </p>
          </div>
        </div>

        <!-- Transferred Download CV & Full View Actions -->
        <div class="flex flex-col xs:flex-row items-center gap-2 pt-1">
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full xs:w-auto flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white transition-all shadow-xs hover:shadow-md cursor-pointer"
          >
            <svg
              class="w-3.5 h-3.5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>View Full CV</span>
          </a>

          <a
            href={pdfUrl}
            download="Arman_Heidari_Academic_CV.pdf"
            class="w-full xs:w-auto flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-zinc-200/80 dark:border-zinc-700 transition-all cursor-pointer"
            aria-label="Download Academic CV PDF"
          >
            <svg
              class="w-3.5 h-3.5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download</span>
          </a>
        </div>
      </div>

      <!-- 2. Work & Industry CV (Future Ready) -->
      <div
        class="relative p-5 sm:p-6 rounded-2xl bg-zinc-50/60 dark:bg-[#12151e]/50 border border-dashed border-zinc-300 dark:border-zinc-800 flex flex-col justify-between space-y-4"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono font-medium bg-zinc-200/70 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-300/60 dark:border-zinc-700/60"
            >
              Work &bull; Industry
            </span>
            <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500"
              >Coming Soon</span
            >
          </div>

          <div class="space-y-1">
            <h2
              class="text-base sm:text-lg font-bold text-zinc-700 dark:text-zinc-300"
            >
              Industry &amp; Work CV
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              Tailored for machine learning engineering, data engineering
              pipelines, and industrial software roles.
            </p>
          </div>
        </div>

        <div class="pt-1">
          <button
            type="button"
            disabled
            class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-xs font-medium bg-zinc-200/60 dark:bg-zinc-800/50 text-zinc-400 dark:text-zinc-500 cursor-not-allowed border border-transparent select-none"
          >
            <span>In Preparation</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Desktop Embedded PDF Viewer (Rendered on tablet and laptop screens >= 768px) -->
    <div
      class="hidden md:block w-full rounded-2xl overflow-hidden bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-sm min-h-[75vh]"
    >
      <iframe
        src={`${pdfUrl}#toolbar=1&navpanes=0`}
        class="w-full h-[80vh] border-0"
        title="Arman Heidari Academic CV"
      >
        <p class="p-6 text-center text-sm text-zinc-600 dark:text-zinc-400">
        Your browser does not support inline PDF viewing. <a href={pdfUrl}
        download class="text-blue-600 underline font-semibold ml-1" > Download
        the CV directly here. </a> </p>
      </iframe>
    </div>
  </div>
</BaseLayout>
