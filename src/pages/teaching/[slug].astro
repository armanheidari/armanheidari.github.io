---
// src/pages/teaching/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { teachingItems } from '../../data/teaching';

export function getStaticPaths() {
  return teachingItems.map((item, index) => {
    // If index === 0, previous is Section 02: Education & Honors
    const prev = index > 0
      ? {
          label: "Previous Experience",
          title: teachingItems[index - 1].title,
          href: `/teaching/${teachingItems[index - 1].slug}`
        }
      : {
          label: "Previous Section",
          title: "02 - Education & Academic Honors",
          href: `/#education`
        };

    // If index === last, next is Section 04: Research & Publications
    const next = index < teachingItems.length - 1
      ? {
          label: "Next Experience",
          title: teachingItems[index + 1].title,
          href: `/teaching/${teachingItems[index + 1].slug}`
        }
      : {
          label: "Next Section",
          title: "04 - Research & Publications",
          href: `/#research`
        };

    return {
      params: { slug: item.slug },
      props: { item, prev, next },
    };
  });
}

const { item, prev, next } = Astro.props;

const categoryLabels: Record<string, { label: string; color: string }> = {
  teaching: { label: "University Teaching Appointment", color: "emerald" },
  mentorship: { label: "Academic Mentorship & Advisory", color: "blue" },
  leadership: { label: "Departmental Leadership & Service", color: "purple" }
};

const meta = categoryLabels[item.category] || { label: "Academic Appointment", color: "emerald" };
---

<BaseLayout
  title={`${item.title} | ${item.role} | Arman Heidari`}
  description={item.overview}
>
  <div class="space-y-8 sm:space-y-10">
    <!-- Breadcrumb & Back Navigation directly to the card on hub -->
    <div class="flex items-center justify-between">
      <a
        href={`/#card-${item.slug}`}
        class="group inline-flex items-center gap-2 text-xs font-mono font-medium text-zinc-500 hover:text-emerald-600 dark:text-zinc-400 dark:hover:text-emerald-400 transition-colors"
      >
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span>Back to Teaching & Mentorship Hub</span>
      </a>

      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
        Academic Experience / Details
      </span>
    </div>

    <!-- Header Hero Card -->
    <header class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <!-- Category & Badge -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
              {meta.label}
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300">
              {item.badge}
            </span>
          </div>

          <!-- Course / Initiative Title -->
          <h1 class="text-2xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
            {item.title}
          </h1>

          <!-- Role & Supervising Faculty / Department -->
          <div class="space-y-1 pt-0.5">
            <p class="text-base sm:text-lg font-semibold text-emerald-600 dark:text-emerald-400">
              {item.role}
            </p>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 font-medium">
              {item.instructor && (
                <span>
                  Supervising Faculty: <span class="text-zinc-900 dark:text-zinc-100 font-semibold">{item.instructor}</span> •{" "}
                </span>
              )}
              {item.department && <span>{item.department} • </span>}
              <span>{item.institution}</span>
            </p>
          </div>
        </div>

        <!-- Period Badge & External Link -->
        <div class="flex flex-col items-end gap-2 shrink-0">
          <span class="text-xs font-mono font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/90 px-3.5 py-1.5 rounded-xl border border-zinc-200/60 dark:border-zinc-700/60">
            {item.period}
          </span>

          {item.externalUrl && (
            <a
              href={item.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-all shadow-sm shadow-blue-500/20 hover:scale-[1.02] active:scale-[0.98]"
            >
              <span>{item.externalLabel || "View Official Portal"}</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Scope & Overview -->
      <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80 space-y-2">
        <h2 class="text-xs font-mono uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500">
          Scope & Academic Context
        </h2>
        <p class="text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
          {item.overview}
        </p>
      </div>
    </header>

    <!-- Key Responsibilities & Deliverables -->
    <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 shadow-xs space-y-4">
      <div class="flex items-center gap-3 border-b border-zinc-100 dark:border-zinc-800/80 pb-3">
        <div class="w-2.5 h-5 rounded-full bg-emerald-600"></div>
        <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-white">
          Key Responsibilities & Deliverables
        </h2>
      </div>

      <ul class="space-y-3 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
        {item.responsibilities.map((resp) => (
          <li class="flex items-start gap-3">
            <span class="text-emerald-500 mt-1 text-sm font-bold">✔</span>
            <span class="leading-relaxed">{resp}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Bottom Navigation: Prev / Next Switcher Between Cards & Sections -->
    <div class="pt-6 border-t border-zinc-200/60 dark:border-zinc-800/60 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Previous Button -->
      <a
        href={prev.href}
        class="group flex flex-col p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/40 hover:shadow-md transition-all text-left min-w-0 overflow-hidden"
      >
        <span class="text-[11px] font-mono font-semibold text-zinc-400 dark:text-zinc-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors flex items-center gap-1.5 shrink-0">
          <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          <span class="truncate">{prev.label}</span>
        </span>
        <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mt-1 line-clamp-2 leading-snug break-words">
          {prev.title}
        </span>
      </a>

      <!-- Next Button -->
      <a
        href={next.href}
        class="group flex flex-col p-4 rounded-2xl bg-white dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/40 hover:shadow-md transition-all text-right sm:items-end min-w-0 overflow-hidden"
      >
        <span class="text-[11px] font-mono font-semibold text-zinc-400 dark:text-zinc-500 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors flex items-center gap-1.5 justify-end shrink-0">
          <span class="truncate">{next.label}</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </span>
        <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mt-1 line-clamp-2 leading-snug break-words">
          {next.title}
        </span>
      </a>
    </div>
  </div>
</BaseLayout>
