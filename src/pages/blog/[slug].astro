---
// src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});
---

<BaseLayout
  title={`${post.data.title} | ${profile.name}`}
  description={post.data.description}
  article={true}
>
  <article class="max-w-3xl mx-auto space-y-8">
    <!-- Back to Blog Navigation -->
    <div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-zinc-500 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Archive</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 border-b border-zinc-200/60 dark:border-zinc-800/60 pb-6">
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-zinc-400">
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span>Arman Heidari</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold font-serif text-zinc-900 dark:text-white leading-tight tracking-tight">
        {post.data.title}
      </h1>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed">
        {post.data.description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 pt-1">
        {post.data.tags.map((tag) => (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Table of Contents (if headings exist) -->
    {headings && headings.length > 1 && (
      <nav class="p-4 rounded-xl bg-zinc-50 dark:bg-[#12151e] border border-zinc-200/70 dark:border-zinc-800/70 text-xs">
        <h2 class="font-mono uppercase font-semibold text-zinc-700 dark:text-zinc-300 mb-2">
          Table of Contents
        </h2>
        <ul class="space-y-1.5 pl-2">
          {headings.filter(h => h.depth <= 3).map((h) => (
            <li class:list={[h.depth === 3 && "pl-3 text-zinc-500"]}>
              <a href={`#${h.slug}`} class="text-zinc-600 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Long-Form Content -->
    <div class="prose prose-zinc dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed text-zinc-700 dark:text-zinc-300 prose-headings:font-serif prose-headings:font-bold prose-headings:tracking-tight prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-pre:rounded-xl prose-pre:border prose-pre:border-zinc-800">
      <Content />
    </div>

    <!-- Article Author Footer Card -->
    <footer class="mt-12 pt-6 border-t border-zinc-200/60 dark:border-zinc-800/60">
      <div class="p-5 rounded-2xl bg-zinc-50 dark:bg-[#12151e] border border-zinc-200/80 dark:border-zinc-800 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-blue-600 flex items-center justify-center text-white font-bold text-sm tracking-tight shadow-sm">
            {profile.initials}
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-white">
              {profile.name}
            </h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              {profile.role} • Reinforcement Learning & Systems
            </p>
          </div>
        </div>

        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition-all shadow-sm"
        >
          <span>Discuss Note</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  function setupCodeCopyButtons() {
    const preBlocks = document.querySelectorAll('pre');
    preBlocks.forEach((pre) => {
      // Avoid duplicate copy buttons
      if (pre.querySelector('.code-copy-btn')) return;

      pre.classList.add('relative', 'group');
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'code-copy-btn absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 transition-opacity px-2 py-1 text-[11px] font-mono rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 shadow-sm focus:outline-none';
      copyBtn.textContent = 'Copy';

      copyBtn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code', err);
        }
      });

      pre.appendChild(copyBtn);
    });
  }

  setupCodeCopyButtons();
  document.addEventListener('astro:after-swap', setupCodeCopyButtons);
</script>
