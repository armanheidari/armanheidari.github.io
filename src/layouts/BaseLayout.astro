---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const defaultDescription =
  "M.Sc. student in Artificial Intelligence at Sharif University of Technology. Researching reinforcement learning, deep neural architectures, and intelligent systems.";

const {
  title = profile.siteTitle,
  description = defaultDescription,
  image = "/images/arman-heidari.jpg",
  article = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://armanheidari.ir");
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const fullImage = image.startsWith('http') ? image : new URL(image, canonicalURL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://armanheidari.ir/#person",
      "name": profile.name,
      "alternateName": [
        profile.persianName,
        "Arman Heidari Sharif",
        "آرمان حیدری شریف",
        "آرمان حیدری دانشگاه شریف"
      ],
      "url": "https://armanheidari.ir",
      "image": "https://armanheidari.ir/images/arman-heidari.jpg",
      "jobTitle": "Master's Student in Artificial Intelligence",
      "description": `${profile.researchStatement} M.Sc. student at Sharif University of Technology.`,
      "email": `mailto:${profile.email}`,
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "Sharif University of Technology",
        "alternateName": "دانشگاه صنعتی شریف",
        "url": "https://www.sharif.edu"
      },
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Allameh Tabataba'i University",
          "alternateName": "دانشگاه علامه طباطبائی",
          "url": "https://atu.ac.ir"
        }
      ],
      "knowsAbout": [
        "Artificial Intelligence",
        "هوش مصنوعی",
        "Machine Learning",
        "یادگیری ماشین",
        "Deep Learning",
        "یادگیری عمیق",
        "Reinforcement Learning",
        "یادگیری تقویتی",
        "Computer Engineering",
        "مهندسی کامپیوتر",
        "Data Engineering"
      ],
      "sameAs": [
        "https://scholar.google.com/citations?user=fgeLGrAAAAAJ&hl=en",
        "https://orcid.org/0009-0005-7230-1878",
        "https://github.com/armanheidari",
        "https://www.linkedin.com/in/arman-heidari/",
        "https://armanheidari.github.io"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://armanheidari.ir/#website",
      "url": "https://armanheidari.ir",
      "name": "Arman Heidari",
      "description": "Academic portfolio and research hub of Arman Heidari at Sharif University of Technology",
      "publisher": {
        "@id": "https://armanheidari.ir/#person"
      },
      "inLanguage": ["en", "fa"]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Cache-busted Favicons & Touch Icons (Prevents stale browser/PDF tab logos) -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/images/arman-heidari.webp" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Search Engine Indexing & Robots Directives -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Primary SEO & Bilingual Discovery Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta
      name="keywords"
      content="Arman Heidari, آرمان حیدری, دانشگاه صنعتی شریف, Sharif University of Technology, شریف, هوش مصنوعی, یادگیری ماشین, یادگیری تقویتی, Artificial Intelligence, Machine Learning, Deep Learning, Reinforcement Learning, Computer Engineering, مهندسی کامپیوتر, رزومه آرمان حیدری, Arman Heidari CV, Arman Heidari Portfolio, armanheidari.ir"
    />

    <!-- Mobile UI & Browser Chrome Theming -->
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e14" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Arman Heidari" />
    <meta name="application-name" content="Arman Heidari" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph / Telegram / WhatsApp / LinkedIn / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:secure_url" content={fullImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Arman Heidari - Academic Portfolio" />
    <meta property="og:site_name" content="Arman Heidari | Academic Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="fa_IR" />

    <!-- Twitter / X & Telegram Compact Card (Both standard 'name' and compatibility 'property' attributes) -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    <meta name="twitter:image:alt" content="Arman Heidari - Academic Portfolio" />
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImage} />

    <!-- AEO & Search Engine Knowledge Graph (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Zero-FOUC Theme Script -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-[#fafaf9] dark:bg-[#0c0e14] text-zinc-800 dark:text-zinc-200 antialiased selection:bg-indigo-500/20 selection:text-indigo-900 dark:selection:text-indigo-200 font-sans flex flex-col min-h-screen transition-colors duration-200">
    <Header />
    <main class:list={[
      "flex-1 w-full",
      isHome ? "" : "max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12"
    ]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
